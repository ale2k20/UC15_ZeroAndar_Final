<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>uc15.etapa9</groupId>
  <artifactId>ZeroAndar</artifactId>
  <version>1.9.0</version>
  <packaging>jar</packaging>
  <name>ZeroAndar - PI3 Etapa 9</name>

  <!--
    UC15 - Projeto Integrador 3 - Etapa 9
    Front-end Web integrado ao back-end. O projeto reaproveita as classes
    de model/repository/service das etapas anteriores e adiciona Spring MVC,
    JDBC, login por sessao e integracao real com o banco MySQL.
    
    Dados de Login:
       E-mail: alex@zeroandar.com       - senha: 'senha123' - nome: Alex Admin      - papel: Administrador
       E-mail: ricardo@zeroandar.com    - senha: 'senha123' - nome: Ricardo Gomes   - papel: Corretor
       E-mail: patricia@zeroandar.com   - senha: 'senha123' - nome: Patricia Lima   - papel: Corretor
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!--
      Necessario para a aplicacao subir com um servidor (Tomcat embutido)
      e servir as paginas de src/main/resources/static pelo navegador.
      O Tomcat embutido serve as paginas estaticas e os Controllers Spring MVC
      atendem as requisicoes feitas pelo JavaScript.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      Dependencias herdadas da Etapa 7 (JDBC puro), necessarias para
      compilar as classes de model/repository/service copiadas do
      projeto desktop. Nesta etapa (front-end) elas nao sao executadas
      servem apenas de base para a integracao real com o banco na
      Etapa 9, quando o acesso a dados passara a ser feito via Spring.
    -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>9.5.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.12.2</version>
      <scope>test</scope>
    </dependency>

    <!--
      ================================================================
      O projeto usa HTML/JavaScript em src/main/resources/static e não
      necessita de Thymeleaf para esta integração.

      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-thymeleaf</artifactId>
      </dependency>
      ================================================================
    -->
  </dependencies>

  <build>
    <finalName>ZeroAndar-Etapa9</finalName>
    <plugins>
      <!--
        Empacota a aplicacao como um jar executavel (java -jar), com o
        Tomcat embutido dentro do jar. Classe principal:
        uc15.etapa9.zeroandar.ZeroAndarApplication (ver src/main/java).
      -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
